APP_NAME="SOFTTEX FASHIONS WEAR LIMITED"
APP_ENV=production
APP_KEY=base64:tbMu72+yfGQpcuVLIVyrJGU8Jo2UlyHrRIVRoz6Iaao=
APP_DEBUG=false
APP_URL=https://softtexfashions.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------------
# cPanel MySQL Database Credentials
# Replace with your actual cPanel Database Name, User & Password
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourcpanel_softtex_db
DB_USERNAME=yourcpanel_softtex_user
DB_PASSWORD=your_strong_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.softtexfashions.com
MAIL_PORT=465
MAIL_USERNAME=info@softtexfashions.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
