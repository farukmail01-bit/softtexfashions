<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    Options -Indexes

    # Block access to hidden files (.env, .git, etc.)
    RewriteRule ^\.(?!well-known).* - [F,L]

    # Block direct access to sensitive framework folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package\.(json|lock)|vite\.config\.js) - [F,L]

    # Rewrite all web requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
